# Server Configuration
PORT=5000
NODE_ENV=production
BASE_URL=https://your-domain.com

# MongoDB Database Connection
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/civicvoice?retryWrites=true&w=majority

# Redis Configuration for BullMQ Queue
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# AI Extraction (Groq LLM Provider - console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Security & Authentication
API_KEY=change_this_to_a_long_secure_random_string
JWT_SECRET=change_this_to_a_secure_jwt_secret_key

# WhatsApp Cloud API (Meta Business Platform)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_BOT_NUMBER=your_whatsapp_bot_phone_number
